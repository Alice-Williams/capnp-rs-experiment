[package]
name = "capnp-oracle-rpc-benchmark"
version = "0.0.0"
edition = "2021"
publish = false

[workspace]

[dependencies]
capnp = { path = "@RUST_ORACLE@/capnp" }
capnp-rpc = { path = "@RUST_ORACLE@/capnp-rpc" }
futures = "0.3.34"
tokio = { version = "1.53.1", features = ["io-util", "macros", "rt"] }
tokio-util = { version = "0.7.19", features = ["compat"] }
